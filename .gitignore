# ─────────────────────────────────────────────
#  ServiceBoard — Root .gitignore
# ─────────────────────────────────────────────

# ── Dependencies ──────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ── Environment Variables ──────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# ── Next.js ───────────────────────────────────
frontend/.next/
frontend/out/
frontend/build/
frontend/.vercel/
frontend/next-env.d.ts

# ── Build Outputs ─────────────────────────────
dist/
build/
*.tsbuildinfo

# ── Logs ──────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# ── OS & Editor ───────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/settings.json
.vscode/*.code-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Testing ───────────────────────────────────
coverage/
.nyc_output/

# ── Misc ──────────────────────────────────────
*.pem
.cache/
tmp/
